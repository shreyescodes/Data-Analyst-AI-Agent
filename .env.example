# Copy to .env and fill in what you need. Every variable is optional.

# --- LLM (optional) ----------------------------------------------------------
# Without an LLM the app runs in rule-based mode. Any OpenAI-compatible
# chat-completions API works.
#
# Local model, no key needed (nothing leaves your machine):
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5-coder:3b
#   LM Studio:  LLM_BASE_URL=http://localhost:1234/v1   LLM_MODEL=<model id>
#   llama.cpp:  LLM_BASE_URL=http://localhost:8080/v1   LLM_MODEL=local
#   (from Docker, use http://host.docker.internal:<port>/v1)
# LLM_BASE_URL=
# LLM_MODEL=
#
# Hosted provider, key required. With only a key set, the default is the
# Hugging Face router with meta-llama/Llama-3.3-70B-Instruct
# (free token at https://huggingface.co/settings/tokens).
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
#
# Local models on CPU can be slow; raise the timeout if requests time out.
# LLM_TIMEOUT_SECONDS=30

# --- Limits ------------------------------------------------------------------
# MAX_UPLOAD_MB=100
# QUERY_ROW_LIMIT=10000
# QUERY_TIMEOUT_SECONDS=10

# --- Security ----------------------------------------------------------------
# The HTTP API source refuses private/loopback/link-local hosts (SSRF guard).
# Enable only when running locally and you need to fetch from internal hosts.
# ALLOW_PRIVATE_URLS=false

# --- Storage & logging -------------------------------------------------------
# DATA_VERSIONS_DIR=data_versions
# LOG_LEVEL=INFO
