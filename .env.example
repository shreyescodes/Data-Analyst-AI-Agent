# Copy to .env and fill in what you need. Every variable is optional.

# --- LLM (optional) ----------------------------------------------------------
# Without a key the app runs in rule-based mode. Any OpenAI-compatible
# chat-completions API works. Default: Hugging Face Inference Providers
# (free token at https://huggingface.co/settings/tokens).
LLM_API_KEY=
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# LLM_TIMEOUT_SECONDS=30
#
# Examples:
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1    LLM_MODEL=gpt-4o-mini
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1    LLM_MODEL=llama3.1  LLM_API_KEY=ollama

# --- Limits ------------------------------------------------------------------
# MAX_UPLOAD_MB=100
# QUERY_ROW_LIMIT=10000
# QUERY_TIMEOUT_SECONDS=10

# --- Security ----------------------------------------------------------------
# The HTTP API source refuses private/loopback/link-local hosts (SSRF guard).
# Enable only when running locally and you need to fetch from internal hosts.
# ALLOW_PRIVATE_URLS=false

# --- Storage & logging -------------------------------------------------------
# DATA_VERSIONS_DIR=data_versions
# LOG_LEVEL=INFO
